FROM europe-west1-docker.pkg.dev/extender-426409/extender-public-registry/extender-base-env:1.6.0

# Disable all debug messages
ENV WINEDEBUG="-all"
ENV WINEPREFIX="/var/extender/.wine"
ENV DISPLAY=":1"
ENV CLANG_VERSION=20
ENV CLANG_HOME=/usr/lib/llvm-${CLANG_VERSION}
ENV CLANG_RESOURCE_DIR=/usr/lib/llvm-${CLANG_VERSION}/lib/clang/${CLANG_VERSION}
ENV PATH=${CLANG_HOME}/bin:${PATH}:/opt/wine-stable/bin

# Installation notes: https://wiki.winehq.org/Ubuntu
# TODO: Backup the files as descibed here: https://wiki.winehq.org/Ubuntu
RUN \
 apt-get update && \
 apt-get install -y --no-install-recommends \
    xvfb \
    gpg \
    lsb-release \
    software-properties-common \
    gnupg \
    wget \
    python3 \
    python-is-python3 && \
    wget -q https://apt.llvm.org/llvm.sh && \
    chmod +x llvm.sh && \
    ./llvm.sh ${CLANG_VERSION} && \
    rm llvm.sh

# Install wine
ARG WINE_BRANCH="stable"

# hadolint ignore=DL3015 # ignore rule here because --install-recomends stay here according to Wine install documentation
RUN wget -q -O - https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key - &&\
    dpkg --add-architecture i386 \
    && wget -q -NP /etc/apt/sources.list.d/ "https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-$(grep VERSION_CODENAME= /etc/os-release | cut -d= -f2).sources" \
    && apt-get update \
    && DEBIAN_FRONTEND="noninteractive" apt-get install -y --install-recommends "winehq-${WINE_BRANCH}" \
    && rm -rf /var/lib/apt/lists/*

# Install winetricks
RUN wget -nv -O /usr/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks \
    && chmod +x /usr/bin/winetricks && \
  apt-get remove -y wget lsb-release software-properties-common gnupg wget && \
  apt-get autoremove -y && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* && \
  mkdir -p ${WINEPREFIX} && \
  set -xe                     && \
  WINEDLLOVERRIDES="mscoree,mshtml=" xvfb-run wine wineboot && \
  xvfb-run wineserver -w && \
  chown -R extender: $WINEPREFIX
