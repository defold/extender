# Generated by Extender. XcodeGen spec for the wrapper project whose single framework
# target links the aggregator package product.
name: {{WRAPPER_NAME}}
options:
  bundleIdPrefix: com.defold.extender
  deploymentTarget:
    {{XCODEGEN_PLATFORM}}: "{{PLATFORM_MIN_VERSION}}"
  createIntermediateGroups: true
packages:
  {{AGGREGATOR_NAME}}:
    path: ../Package
targets:
  {{WRAPPER_NAME}}:
    type: framework
    platform: {{XCODEGEN_PLATFORM}}
    sources:
      - path: Sources
    settings:
      base:
        CODE_SIGNING_ALLOWED: "NO"
        SWIFT_VERSION: "{{SWIFT_VERSION}}"
        MACH_O_TYPE: {{MACH_O_TYPE}}
        GENERATE_INFOPLIST_FILE: "YES"
        # the build runs in a sandbox, inside which Xcode can't apply its own to the script
        ENABLE_USER_SCRIPT_SANDBOXING: "NO"
    # the settings the package targets impart to the wrapper, which Swift code that imports
    # the packages needs as well
    postCompileScripts:
      - name: Write the imparted build settings
        basedOnDependencyAnalysis: false
        outputFiles:
          - $(PROJECT_DIR)/{{BUILD_SETTINGS_FILE}}
        script: |
          printf 'OTHER_SWIFT_FLAGS=%s\n' "$OTHER_SWIFT_FLAGS" > "$SCRIPT_OUTPUT_FILE_0"
    dependencies:
      - package: {{AGGREGATOR_NAME}}
        product: {{AGGREGATOR_NAME}}
